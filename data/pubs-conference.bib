
@inproceedings{karpel_replication_2025,
	title = {Replication of prefrontal asymmetry in approach-avoidance motivation in {fMRI}},
	volume = {47},
	abstract = {A large body of research suggests that approach-related emotional states are lateralized to the left prefrontal cortex (Harmon-Jones \& Gable, 2018). However, because affective motivation and valence have often been entangled in experimental designs, it is unclear which construct drives this laterality. In one fMRI study designed to dissociate motivation and valence, Berkman and Lieberman (2010) found that approach motivation was more left-lateralized than avoidance motivation in the dorsolateral prefrontal cortex (DLPFC), controlling for valence. Our study did not replicate this key finding from Berkman and Lieberman (2010). Furthermore, whereas Berkman and Lieberman (2010) found that individuals’ trait approach motivation predicted the laterality of approach-related DLPFC activity, we found that trait approach motivation predicted the laterality of positive valence, controlling for motivation. Overall, our results do not provide any clear support for the ’textbook’ model of affective motivation in the frontal lobes.},
	booktitle = {Proceedings of the {Annual} {Meeting} of the {Cognitive} {Science} {Society}},
	author = {Karpel, Rebecca and Morgan, Owen P. and Singh, Amritpal and Yap, De Fu and Brookshire, Geoffrey and Pawletko, Kira and Casasanto, Daniel},
	year = {2025},
	file = {Karpel et al. - 2025 - Replication of prefrontal asymmetry in approach-av.pdf:/Users/om/Library/CloudStorage/GoogleDrive-owen.morgan95@gmail.com/My Drive/Zotero_files/K/Karpel et al. - 2025 - Replication of prefrontal asymmetry in approach-av.pdf:application/pdf},
}



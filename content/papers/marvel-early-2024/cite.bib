@article{marvel_early_2024,
 abstract = {Lyme disease (LD) is a tick-borne infection due to the bacteria Borrelia burgdorferi. After antibiotic treatment, 10-20% of patients develop post-treatment Lyme disease (PTLD). Neurological symptoms are commonly reported in PTLD. This case-control study tested the hypothesis that brain changes occur in LD and are related to clinical outcomes.},
 author = {Marvel, Cherie L. and Rebman, Alison W. and Alm, Kylie H. and Touradji, Pegah and Bakker, Arnold and Nadkarni, Prianca A. and Bhattacharya, Deeya and Morgan, Owen P. and Mistri, Amy and Sandino, Christopher C. and Ecker, Jonathan A. and Kozero, Erica A. and Venkatesan, Arun and Moghekar, Abhay and Keeys, Ashar A. and Aucott, John N.},
 copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
 doi = {10.1101/2024.12.16.24319088},
 file = {Marvel et al. - 2024 - Early brain changes in Lyme disease are associated.pdf:/Users/om/Library/CloudStorage/GoogleDrive-owen.morgan95@gmail.com/My Drive/Zotero_files/M/Marvel et al. - 2024 - Early brain changes in Lyme disease are associated.pdf:application/pdf},
 journal = {MedRxiv},
 language = {en},
 title = {Early brain changes in Lyme disease are associated with clinical outcomes},
 url = {http://medrxiv.org/lookup/doi/10.1101/2024.12.16.24319088},
 urldate = {2025-02-11},
 year = {2024}
}

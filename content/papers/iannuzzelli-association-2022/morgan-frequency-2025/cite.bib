@article{morgan_frequency_2025,
 abstract = {This study seeks to explain a fundamental principle of perception in brain and behavior: Sights and sounds in the left and right perceptual ﬁelds are processed differently depending on their spatiotemporal frequencies (how ﬁne-grained, or fast-changing, they are). Beyond perception, these asymmetries could potentially help explain the organization of language and the origin of the mental number line. Yet, the cause of these asymmetries has remained mysterious. To test a new explanation for these phenomena, we recruited from a group of people who have been underrepresented in cognitive neuroscience: left handers. In a series of three preregistered experiments, we ﬁnd evidence that frequency asymmetries in vision may arise from asymmetries in how people use their hands to perform everyday actions.},
 author = {Morgan, Owen and Casasanto, Daniel},
 doi = {10.1037/xge0001806},
 file = {Morgan and Casasanto - 2025 - Frequency asymmetries in vision The action asymme.pdf:/Users/om/Library/CloudStorage/GoogleDrive-owen.morgan95@gmail.com/My Drive/Zotero_files/M/Morgan and Casasanto - 2025 - Frequency asymmetries in vision The action asymme.pdf:application/pdf},
 issn = {1939-2222, 0096-3445},
 journal = {Journal of Experimental Psychology: General},
 language = {en},
 shorttitle = {Frequency asymmetries in vision},
 title = {Frequency asymmetries in vision: The action asymmetry hypothesis},
 url = {https://doi.apa.org/doi/10.1037/xge0001806},
 urldate = {2025-07-01},
 year = {2025}
}
